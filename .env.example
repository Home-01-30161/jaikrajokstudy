# Copy to .env — fill in values. Never commit .env
#
# On the hackathon server:
#   - Secrets go to GitLab > Settings > CI/CD > Variables, prefixed APP_
#   - e.g.  APP_AIFORTHAI_API_KEY, APP_LINE_CHANNEL_ACCESS_TOKEN, APP_LINE_CHANNEL_SECRET
#   - CI writes them to .env automatically before docker compose up
#   - Non-secret env vars are set directly in docker-compose.yml environment block

# AI for Thai
AIFORTHAI_API_KEY=
AIFORTHAI_BASE_URL=https://api.aiforthai.in.th

# Pathumma (override if your endpoint differs)
PATHUMMA_ENDPOINT=
PATHUMMA_MODEL=pathumma-llm-text-1.0.0

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# App (set by docker-compose.yml on server — override locally as needed)
APP_ENV=development
LOG_LEVEL=INFO
ROOT_PATH=
TEAM=team07
HOST=0.0.0.0
PORT=8000

# Set to 1 ONLY for local shells whose CA bundle is broken (MSYS2 Python).
# Leave unset/0 everywhere else so outbound TLS certificates are verified.
INSECURE_TLS=0

# Pathumma TokenMind gateway (OpenAI-compatible): serves the LLM and ASR.
# Sentiment / face / OCR / TTS are NOT on this gateway and still use
# AIFORTHAI_API_KEY above, so both credentials are required.
TOKENMIND_API_KEY=
TOKENMIND_BASE_URL=https://tokenmind.pathumma.in.th/v1
TOKENMIND_LLM_MODEL=thaillm-8b
TOKENMIND_ASR_MODEL=ptm-asr-1
TOKENMIND_TTS_MODEL=ptm-tts-1
# No /v1/voices route exists yet; leave blank until a voice id is published.
TOKENMIND_TTS_VOICE=
